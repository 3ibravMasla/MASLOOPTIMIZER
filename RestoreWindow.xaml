<Window x:Class="MASLOOPTIMIZER.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASLOOPTIMIZER — Відновлення реєстру та системи" Height="580" Width="820"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1.5" CornerRadius="10" Background="{DynamicResource HeaderBg}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔄 ВІДНОВЛЕННЯ РЕЄСТРУ ТА СТАНУ СИСТЕМИ" FontSize="15" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                    <TextBlock Text="Оберіть створену точку бекапу або запустіть системне відновлення Windows" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- Список бекапів -->
            <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BackupItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:BackupEntry}" xmlns:local="clr-namespace:MASLOOPTIMIZER">
                                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <WrapPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name, StringFormat='📁 {0}'}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                                                <Border Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding SizeFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreen}"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding FormattedDate, StringFormat='Створено: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="⚡ Відновити" Background="#0078D4" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnRestoreItem_Click" Tag="{Binding}"/>
                                            <Button Content="🗑️" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Padding="8,6" Cursor="Hand" Click="BtnDeleteItem_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Нижня панель кнопок -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="🛡️ Системне відновлення Windows (VSS UI)" Style="{StaticResource HeaderActionBtn}" Margin="0,0,8,0" Click="BtnSystemRestoreUI_Click"/>
                    <Button Content="📂 Відкрити папку бекапів" Style="{StaticResource HeaderActionBtn}" Click="BtnOpenFolder_Click"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Закрити" Style="{StaticResource HeaderActionBtn}" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>