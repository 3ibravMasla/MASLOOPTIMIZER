<Application x:Class="MASLOOPTIMIZER.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Базові кольори Cyber Dark за замовчуванням -->
        <SolidColorBrush x:Key="WindowBg" Color="#0B0C10"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#12141C"/>
        <SolidColorBrush x:Key="HeaderBorder" Color="#1E2230"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#10121A"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#1A1E2B"/>
        <SolidColorBrush x:Key="CardBg" Color="#151722"/>
        <SolidColorBrush x:Key="CardBorder" Color="#212536"/>
        <SolidColorBrush x:Key="ActionBtnBg" Color="#181B26"/>
        <SolidColorBrush x:Key="ActionBtnBorder" Color="#262C3E"/>
        <SolidColorBrush x:Key="NavBtnBg" Color="Transparent"/>
        <SolidColorBrush x:Key="NavBtnHover" Color="#181B28"/>
        <SolidColorBrush x:Key="NavBtnActive" Color="#1E2333"/>
        <SolidColorBrush x:Key="NavBtnBorderActive" Color="#00FF9D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="StatusBg" Color="#12141C"/>
        <SolidColorBrush x:Key="StatusBorder" Color="#1E2230"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF9D"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#161924"/>
        <SolidColorBrush x:Key="BadgeText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="#181B26"/>
        <SolidColorBrush x:Key="ProgressFill" Color="#00FF9D"/>
        <SolidColorBrush x:Key="ChipBg" Color="#1E2235"/>
        <SolidColorBrush x:Key="ChipBorder" Color="#334155"/>
        <SolidColorBrush x:Key="ChipText" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ChipHoverBg" Color="#2A344A"/>
        <SolidColorBrush x:Key="ChipActiveBg" Color="#0078D4"/>
        <SolidColorBrush x:Key="ChipActiveBorder" Color="#38BDF8"/>
        <SolidColorBrush x:Key="ChipActiveText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="StatusStdBg" Color="#2A2D3D"/>
        <SolidColorBrush x:Key="StatusStdText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00FF9D"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#334155"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#107C41"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#0369A1"/>
        <SolidColorBrush x:Key="StatusNeutralBrush" Color="#2A2D3D"/>
        <SolidColorBrush x:Key="SuccessText" Color="#4ADE80"/>
        <SolidColorBrush x:Key="WarningText" Color="#FBBF24"/>
        <SolidColorBrush x:Key="DangerText" Color="#F87171"/>
        <SolidColorBrush x:Key="InfoText" Color="#38BDF8"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Display"/>
        </Style>

        <!-- Стиль навігаційних кнопок сайдбара -->
        <Style x:Key="SidebarNavBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NavBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavBtnHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопок дій у шапці -->
        <Style x:Key="HeaderActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ActionBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActionBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ChipHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Перемикач випадаючого списку ComboBox (без системного хрому) -->
        <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Глобальний стиль ComboBox: фіксує білий фон Popup у темних темах -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ActionBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActionBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="BoxBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            <ToggleButton x:Name="DropToggle"
                                          Style="{StaticResource ComboToggleStyle}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,20,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>
                            <Path x:Name="Arrow"
                                  Data="M0,0 L3.5,3.5 L7,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Stroke="{DynamicResource TextMuted}"
                                  StrokeThickness="1.5"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   VerticalOffset="3">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      SnapsToDevicePixels="True">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"/>
                                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункти випадаючого списку: світлий текст на темному фоні -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BorderMuted}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ChipActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ChipActiveText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================
             УНІВЕРСАЛЬНИЙ СТИЛЬ MenuItem: текст TextPrimary, без сірої смуги
             IconColumn (зона іконок прозора, пункти — "пігулки").
             При наведенні (IsHighlighted) — фон BorderMuted, текст TextPrimary.
             Підтримує іконки, підменю (Popup) та галочки IsChecked.
             ================================================================ -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="templateRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconCol"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Іконка пункту (прозора зона — без сірої смуги) -->
                                <ContentPresenter x:Name="IconHost" Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Width="18" Height="18" Margin="0,0,6,0"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True"/>

                                <!-- Галочка для IsChecked -->
                                <Border x:Name="GlyphPanel" Grid.Column="0"
                                        Width="18" Height="18" Margin="0,0,6,0"
                                        Background="{DynamicResource ChipActiveBg}"
                                        BorderBrush="{DynamicResource ChipActiveBorder}"
                                        BorderThickness="1" CornerRadius="4"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <Path x:Name="Glyph" Data="M 0,5.5 L 3.5,9 L 9,1.5"
                                          Stroke="{DynamicResource ChipActiveText}"
                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,8,0"/>

                                <!-- Стрілка підменю -->
                                <Path x:Name="RightArrow" Grid.Column="2"
                                      Data="M0,0 L4,4 L0,8"
                                      Stroke="{DynamicResource TextSecondary}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="8,0,2,0" Visibility="Collapsed"/>

                                <!-- Вкладене підменю -->
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="Fade" Placement="Right"
                                       PlacementTarget="{Binding ElementName=templateRoot}"
                                       HorizontalOffset="-2" VerticalOffset="-3">
                                    <Border Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="2"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Grid.IsSharedSizeScope="True"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"
                                                            Margin="1"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Без іконки — колонка не резервується (немає "сірої смуги") -->
                            <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- Пункт, що відкриває підменю -->
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Відображення галочки для IsCheckable -->
                            <Trigger Property="IsCheckable" Value="True">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Наведення: контрастний фон + основний текст -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource BorderMuted}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <!-- Вимкнений пункт -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter TargetName="IconHost" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================
             УНІВЕРСАЛЬНИЙ СТИЛЬ ContextMenu: фон CardBg, рамка CardBorder,
             скруглення 8px, тінь. Працює однаково на Neon/Dark та Light темах.
             ================================================================ -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="2"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Grid.IsSharedSizeScope="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                                Margin="1"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль апаратних бейджів -->
        <Style x:Key="HwBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BadgeBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActionBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Application.Resources>
</Application>