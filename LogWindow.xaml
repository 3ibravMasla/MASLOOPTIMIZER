<Window x:Class="MASLOOPTIMIZER.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASLOOPTIMIZER — Історія дій та логи" Height="500" Width="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1.5" CornerRadius="10" Background="{DynamicResource HeaderBg}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📊 ІСТОРІЯ ДІЙ ТА СИСТЕМНИЙ ЖУРНАЛ" FontSize="14" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                    <TextBlock Text="Журнал виконання твіків, аналізу та службових операцій" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                    <Border Grid.Column="1" Background="{Binding LevelColor}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Level}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource TextPrimary}" FontSize="11" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Right" Content="Закрити" Style="{StaticResource HeaderActionBtn}" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>