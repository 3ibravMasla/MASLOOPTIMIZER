<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon\maslo.ico</ApplicationIcon>
    <StartupObject>MASLOOPTIMIZER.App</StartupObject>
    <RootNamespace>MASLOOPTIMIZER</RootNamespace>
    <AssemblyName>MASLOOPTIMIZER</AssemblyName>
    <Version>0.4.6</Version>
    <AssemblyVersion>0.4.6</AssemblyVersion>
    <FileVersion>0.4.6</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon\maslo.jpg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="tweaks.bundle.json" />
    <!-- Іконка трею та мовні файли вшиті в exe (single-file publish) -->
    <EmbeddedResource Include="icon\maslo.ico" />
    <EmbeddedResource Include="Languages\**\*.json" />
  </ItemGroup>

</Project>