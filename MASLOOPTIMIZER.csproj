<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon\maslo.ico</ApplicationIcon>
    <StartupObject>MASLOOPTIMIZER.App</StartupObject>
    <RootNamespace>MASLOOPTIMIZER</RootNamespace>
    <AssemblyName>MASLOOPTIMIZER</AssemblyName>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0</AssemblyVersion>
    <FileVersion>0.6.0</FileVersion>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- v0.6.0: перехід із single-file на модульну ZIP-готову структуру папок.
         R2R застосовується під час dotnet publish (потрібен RID win-x64 — заданий вище). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- v0.6.0: чистота publish-папки. Рантайм тягне ~13 мовних satellite-збірок
         (cs/de/es/fr/it/ja/ko/pl/pt-BR/ru/tr/zh-Hans/zh-Hant), яких ми не використовуємо:
         власна локалізація живе в Languages\*.json як EmbeddedResource. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon\maslo.jpg" />
  </ItemGroup>

  <!-- v0.6.0: зовнішні .bat-скрипти твіків копіюються в папку збірки (модульний ZIP-ready layout).
       ExcludeFromSingleFile: навіть у single-file режимі .bat лишаються реальними файлами на диску,
       бо TweakEngine.RunScriptChecked запускає їх через cmd.exe за AppDomain.CurrentDomain.BaseDirectory. -->
  <ItemGroup>
    <Content Include="Scripts\**\*.*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Локалізований банл твіків поруч з exe (можна оновлювати без перезбірки) -->
    <Content Include="tweaks.bundle.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Tools/ містить лише службові .ps1/.md — не компілювати його вміст
       (інакше тимчасові скрипти/харнеси ламають збірку дубльованими атрибутами) -->
  <ItemGroup>
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
    <Page Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="tweaks.bundle.json" />
    <!-- Іконка трею та мовні файли вшиті в exe (single-file publish) -->
    <EmbeddedResource Include="icon\maslo.ico" />
    <EmbeddedResource Include="Languages\**\*.json" />
  </ItemGroup>

</Project>