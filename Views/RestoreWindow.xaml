<Window x:Class="MASLOOPTIMIZER.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MASLOOPTIMIZER"
        Title="RestoreWindow" Height="580" Width="820"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1.5" CornerRadius="10" 
            Background="{DynamicResource HeaderBg}" Padding="22" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#x2715;" Background="Transparent" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" IsCancel="True"/>
            </Grid>

            <!-- Backup list -->
            <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <TextBlock x:Name="LblSortBackup" Text="Сортування:" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="BackupSortComboBox"
                                  SelectionChanged="BackupSortComboBox_SelectionChanged"
                                  Width="200"
                                  Height="28"
                                  VerticalContentAlignment="Center"
                                  Background="{DynamicResource HeaderBg}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource ActionBtnBorder}">
                            <ComboBoxItem Content="📅 Новіші спочатку"
                                          IsSelected="True"
                                          Tag="DateDescending"/>
                            <ComboBoxItem Content="📅 Старіші спочатку"
                                          Tag="DateAscending"/>
                            <ComboBoxItem Content="📦 За розміром"
                                          Tag="SizeDescending"/>
                            <ComboBoxItem Content="🔑 За кількістю ключів"
                                          Tag="KeyCountDescending"/>
                            <ComboBoxItem Content="🔤 За назвою (А-Я)"
                                          Tag="NameAscending"/>
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyBackupsNotice" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BackupItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BackupEntry}">
                                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name, StringFormat='&#x1F4C1; {0}'}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                                                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreen}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding CreatedText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding RestoreButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource ChipActiveBg}" Foreground="{DynamicResource ChipActiveText}" FontWeight="Bold" FontSize="11" Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnRestoreItem_Click" Tag="{Binding}"/>
                                                <Button Content="{Binding DeleteButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Padding="8,6" Cursor="Hand" Click="BtnDeleteItem_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnSystemRestore" Style="{StaticResource HeaderActionBtn}" Margin="0,0,8,0" Click="BtnSystemRestoreUI_Click"/>
                    <Button x:Name="BtnOpenFolder" Style="{StaticResource HeaderActionBtn}" Click="BtnOpenFolder_Click"/>
                </StackPanel>
                <Button x:Name="BtnClose" Grid.Column="2" Style="{StaticResource HeaderActionBtn}" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>