<Window x:Class="MASLOOPTIMIZER.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MASLOOPTIMIZER"
        Title="MASLOOPTIMIZER — Налаштування" Height="720" Width="880"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        MinWidth="640" MinHeight="520">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Display"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <DataTemplate DataType="{x:Type local:ThemeCard}">
            <Button Width="130" Height="90" Margin="4" Padding="0" VerticalContentAlignment="Top"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeCard_Click" Tag="{Binding Key}">
                <StackPanel>
                    <!-- Фіксована область мініатюри (прев'ю вікна) -->
                    <Border Height="52" CornerRadius="6" Background="{Binding PreviewBg}" BorderBrush="{Binding PreviewAccent}" BorderThickness="2">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="9" CornerRadius="2" Background="{Binding PreviewAccent}"/>
                            <Border Grid.Row="1" Margin="0,5,0,0" CornerRadius="2" Background="{Binding PreviewCard}"/>
                        </Grid>
                    </Border>
                    <!-- Фіксована область тексту: назва та категорія на тему інтерфейсу -->
                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="🔍 Масштаб інтерфейсу (UI Scaling)"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ScaleSlider" Grid.Column="0" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ScaleSlider_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="ScaleValueText" Text="100%" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="48" TextAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="Застосовується миттєво та зберігається після перезапуску." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="🎨 Тема інтерфейсу"/>
                    <ItemsControl x:Name="ThemeItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="🚀 Автозапуск Windows"/>
                    <CheckBox x:Name="ChkWidgetOnly" Content="Запускати тільки Віджет при старті Windows" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,6,0,0" Checked="ChkWidgetOnly_Changed" Unchecked="ChkWidgetOnly_Changed"/>
                    <CheckBox x:Name="ChkSilent" Content="Запускати повну програму згорнутою в трей" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,6,0,0" Checked="ChkSilent_Changed" Unchecked="ChkSilent_Changed"/>
                    <TextBlock Text="Прапорці зберігаються у HKCU\...\Run з аргументами --widget-only / -silent." FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="🌐 Мова інтерфейсу"/>
                    <Button x:Name="BtnLanguage" Content="🌐 Мова" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ActionBtnBorder}" BorderThickness="1" Padding="12,7" HorizontalAlignment="Left" Cursor="Hand" Click="BtnLanguage_Click"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnClose" Content="Закрити" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ActionBtnBorder}" BorderThickness="1" Padding="14,8" HorizontalAlignment="Left" Cursor="Hand" Click="BtnClose_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
