<Window x:Class="MASLOOPTIMIZER.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASLOOPTIMIZER — Апаратний аудит та сенсори телеметрії" Height="720" Width="1000"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="SpecCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,2,6,2"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TempBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BadgeBg}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1.5" CornerRadius="10" 
            Background="{DynamicResource HeaderBg}" Padding="20" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Хедер -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtTitle" Text="🔍 АПАРАТНИЙ АУДИТ ТА СЕНСОРИ ТЕЛЕМЕТРІЇ" FontSize="14.5" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLiveBadge" Text="Live Telemetry" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="Детальна інформація про апаратні вузли, термозони, кеш, контролери та підсистеми ПК" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" IsCancel="True"/>
            </Grid>

            <!-- 2. Контентна область діагностики -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Блок CPU & Температури термозон -->
                    <Border Style="{StaticResource SpecCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblCpuSection" Text="🔥 ПРОЦЕСОР (CPU) &amp; ТЕРМОЗОНИ" FontSize="12.5" FontWeight="Black" Foreground="{DynamicResource WarningText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtCpuLoad" Text="Навантаження: 12 %" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource InfoText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtCpuTemp" Text="Пакет: 45 °C" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource InfoText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtVrmTemp" Text="VRM: 48 °C" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WarningText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtBoardTemp" Text="Плата: 34 °C" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessText}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblModel" Text="Модель:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtCpuModel" Text="Завантаження..." Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblConfig" Text="Конфігурація:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtCpuCores" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblSocket" Text="Сокет:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtCpuSocket" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblBaseFreq" Text="Базова частота:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtCpuBaseClock" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblMaxFreq" Text="Макс. частота:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtCpuClock" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblCache" Text="Кеш L3 / L2:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtCpuCache" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblVirtual" Text="Віртуалізація:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtCpuVirtual" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Блок GPU & Сенсори відеопам'яті -->
                    <Border Style="{StaticResource SpecCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblGpuSection" Grid.Column="0" Text="🎮 ВІДЕОКАРТА (GPU) &amp; МОНІТОРИ" FontSize="12.5" FontWeight="Black" Foreground="{DynamicResource InfoText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtGpuLoad" Text="Load: 35 %" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtGpuCoreTemp" Text="GPU: 42 °C" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource InfoText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtGpuHotspotTemp" Text="Hotspot: 54 °C" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DangerText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtGpuVramTemp" Text="VRAM: 50 °C" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WarningText}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblGpuModel" Text="Модель GPU:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtGpuModel" Text="Завантаження..." Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblGpuVram" Text="Відеопам'ять:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtGpuVram" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblGpuBus" Text="Шина &amp; ReBAR:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtGpuBus" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblGpuDriver" Text="Драйвер:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtGpuDriver" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblGpuClockPower" Text="Частота / Споживання:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtGpuPowerClock" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblGpuFan" Text="Кулери (Fan):" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtGpuFan" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <TextBlock x:Name="LblGpuDisplays" Text="Підключені дисплеї:" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtGpuDisplays" Text="Завантаження дисплеїв..." Style="{StaticResource MetricValue}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Блок Оперативної пам'яті (RAM) -->
                    <Border Style="{StaticResource SpecCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblRamSection" Grid.Column="0" Text="⚡ ОПЕРАТИВНА ПАМ'ЯТЬ (RAM)" FontSize="12.5" FontWeight="Black" Foreground="{DynamicResource InfoText}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource TempBadge}">
                                    <TextBlock x:Name="TxtRamSpeedBadge" Text="DDR5 @ 6000 MT/s" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource InfoText}"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblRamCapacity" Text="Обсяг пам'яті:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtRamCapacity" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblRamLoad" Text="Завантаження RAM:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtRamLoad" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblRamSlots" Text="Слоти DIMM:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtRamSlots" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="LblRamModules" Text="Встановлені модулі:" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtRamModulesList" Text="Завантаження планок..." Style="{StaticResource MetricValue}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Блок Накопичувачів & Системної плати -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Накопичувачі -->
                        <Border Grid.Column="0" Style="{StaticResource SpecCard}" Margin="0,0,6,10">
                            <StackPanel>
                                <TextBlock x:Name="LblStorageSection" Text="💾 НАКОПИЧУВАЧІ ТА ТОМИ" FontSize="12.5" FontWeight="Black" Foreground="{DynamicResource AccentGreen}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtStorageVolumes" Text="Завантаження дисків..." Style="{StaticResource MetricValue}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Системна плата & Мережа -->
                        <Border Grid.Column="1" Style="{StaticResource SpecCard}" Margin="6,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="LblBoardSection" Text="🎛️ ПЛАТА, BIOS ТА МЕРЕЖА" FontSize="12.5" FontWeight="Black" Foreground="{DynamicResource DangerText}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblBoardModel" Text="Материнська плата:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtBoardModel" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblBios" Text="Версія BIOS:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtBiosVersion" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblNetAdapter" Text="Мережевий адаптер:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtNetAdapter" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblNetIp" Text="IPv4 / Пінг шлюзу:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtNetIpPing" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="LblSecurity" Text="Безпека:" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TxtSecurityStatus" Text="-" Style="{StaticResource MetricValue}"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Нижня панель дій -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnCopyReport" Content="📋 Скопіювати повний звіт" Style="{StaticResource HeaderActionBtn}" Click="BtnCopyReport_Click"/>
                    <Button x:Name="BtnSaveReport" Content="💾 Зберегти звіт (.txt)" Style="{StaticResource HeaderActionBtn}" Click="BtnSaveReport_Click"/>
                    <Button x:Name="BtnRefresh" Content="🔄 Оновити сенсори" Style="{StaticResource HeaderActionBtn}" Click="BtnRefresh_Click"/>
                </StackPanel>

                <Button x:Name="BtnCloseWindow" Grid.Column="2" Content="Закрити" Style="{StaticResource HeaderActionBtn}" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>