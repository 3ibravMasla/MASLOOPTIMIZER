<Window x:Class="MASLOOPTIMIZER.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASLOOPTIMIZER — Апаратний аудит та сенсори телеметрії"
        Height="740"
        Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="SpecCard"
                TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="8"/>
            <Setter Property="Padding"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MetricLabel"
                TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin"
                    Value="0,2,6,2"/>
        </Style>

        <Style x:Key="MetricValue"
                TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11.5"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin"
                    Value="0,2,0,2"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TempBadge"
                TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource BadgeBg}"/>
            <Setter Property="CornerRadius"
                    Value="4"/>
            <Setter Property="Padding"
                    Value="6,2"/>
            <Setter Property="Margin"
                    Value="4,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AccentGreen}"
            BorderThickness="1.5"
            CornerRadius="10"
            Background="{DynamicResource HeaderBg}"
            Padding="20"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Хедер -->
            <Grid Grid.Row="0"
                    Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtTitle"
                                Text="🔍 АПАРАТНИЙ АУДИТ ТА СЕНСОРИ ТЕЛЕМЕТРІЇ"
                                FontSize="14.5"
                                FontWeight="Black"
                                Foreground="{DynamicResource AccentGreen}"/>
                        <Border Background="{DynamicResource BadgeBg}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="10,0,0,0"
                                BorderBrush="{DynamicResource AccentGreen}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLiveBadge"
                                    Text="Live Telemetry"
                                    FontSize="9.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource AccentGreen}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle"
                            Text=""
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Background="Transparent"
                        Foreground="{DynamicResource TextMuted}"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnClose_Click"
                        IsCancel="True"/>
            </Grid>

            <!-- 2. Контентна область діагностики -->
            <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Margin="0,0,0,12">
                <StackPanel>

                    <!-- ОС та безпека -->
                    <Border Style="{StaticResource SpecCard}">
                        <StackPanel>
                            <TextBlock x:Name="LblOsSection"
                                    Text="🖥️ ОПЕРАЦІЙНА СИСТЕМА ТА БЕЗПЕКА"
                                    FontSize="12.5"
                                    FontWeight="Black"
                                    Foreground="{DynamicResource AccentGreen}"
                                    Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblOsVersion"
                                                Text="Версія Windows:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtOsVersion"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblOsUptime"
                                                Text="Час роботи:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtOsUptime"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblDirectX"
                                                Text="DirectX:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtDirectX"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblPowerPlan"
                                                Text="Схема живлення:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtPowerPlan"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblVbs"
                                                Text="VBS / Memory Integrity:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtVbs"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblSecureBoot"
                                                Text="Secure Boot:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtSecureBoot"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblTpm"
                                                Text="TPM:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtTpm"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Процесор -->
                    <Border Style="{StaticResource SpecCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                    Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblCpuSection"
                                        Grid.Column="0"
                                        Text="🔥 ПРОЦЕСОР (CPU)"
                                        FontSize="12.5"
                                        FontWeight="Black"
                                        Foreground="{DynamicResource WarningText}"
                                        VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtCpuLoad"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource InfoText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtCpuTemp"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource WarningText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtCpuPower"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource SuccessText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtCpuVcore"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextPrimary}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtCpuClock"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource InfoText}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblModel"
                                                Text="Модель:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtCpuModel"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblConfig"
                                                Text="Ядра / Потоки:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtCpuCores"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblSocket"
                                                Text="Сокет:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtCpuSocket"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblCpuArch"
                                                Text="Архітектура:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtCpuArch"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblBaseFreq"
                                                Text="Базова частота:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtCpuBaseClock"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblBoostFreq"
                                                Text="Макс. частота:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtCpuBoostClock"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblCache"
                                                Text="Кеш L1 / L2 / L3:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtCpuCache"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblVirtual"
                                                Text="Віртуалізація:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtCpuVirtual"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Відеокарта -->
                    <Border Style="{StaticResource SpecCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                    Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblGpuSection"
                                        Grid.Column="0"
                                        Text="🎮 ВІДЕОКАРТА (GPU)"
                                        FontSize="12.5"
                                        FontWeight="Black"
                                        Foreground="{DynamicResource InfoText}"
                                        VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtGpuLoad"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource SuccessText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtGpuCoreTemp"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource InfoText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtGpuHotspotTemp"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource DangerText}"/>
                                    </Border>
                                    <Border Style="{StaticResource TempBadge}">
                                        <TextBlock x:Name="TxtGpuVramTemp"
                                                Text="—"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource WarningText}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Right">
                                <Border Style="{StaticResource TempBadge}">
                                    <TextBlock x:Name="TxtGpuPower"
                                            Text="—"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource SuccessText}"/>
                                </Border>
                                <Border Style="{StaticResource TempBadge}">
                                    <TextBlock x:Name="TxtGpuCoreClock"
                                            Text="—"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource InfoText}"/>
                                </Border>
                                <Border Style="{StaticResource TempBadge}">
                                    <TextBlock x:Name="TxtGpuMemClock"
                                            Text="—"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource InfoText}"/>
                                </Border>
                                <Border Style="{StaticResource TempBadge}">
                                    <TextBlock x:Name="TxtGpuFan"
                                            Text="—"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                                <Border Style="{StaticResource TempBadge}">
                                    <TextBlock x:Name="TxtGpuVramUsed"
                                            Text="—"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblGpuModel"
                                                Text="Модель GPU:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtGpuModel"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblGpuVram"
                                                Text="Відеопам'ять:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtGpuVram"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblGpuDriver"
                                                Text="Драйвер:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtGpuDriver"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblGpuBus"
                                                Text="Шина / ReBAR:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtGpuBus"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LblGpuDisplays"
                                            Text="Підключені дисплеї:"
                                            Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtGpuDisplays"
                                            Text="—"
                                            Style="{StaticResource MetricValue}"
                                            TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Оперативна пам'ять -->
                    <Border Style="{StaticResource SpecCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                    Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblRamSection"
                                        Grid.Column="0"
                                        Text="⚡ ОПЕРАТИВНА ПАМ'ЯТЬ (RAM)"
                                        FontSize="12.5"
                                        FontWeight="Black"
                                        Foreground="{DynamicResource InfoText}"
                                        VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Style="{StaticResource TempBadge}">
                                    <TextBlock x:Name="TxtRamSpeedBadge"
                                            Text="—"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource InfoText}"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblRamCapacity"
                                                Text="Загальний обсяг:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtRamCapacity"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblRamType"
                                                Text="Тип пам'яті:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtRamType"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblRamSlots"
                                                Text="Слоти DIMM:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtRamSlots"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblRamUsed"
                                                Text="Використано:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtRamUsed"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblRamAvailable"
                                                Text="Доступно:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtRamAvailable"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblRamUsage"
                                                Text="Завантаження:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtRamUsage"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblRamCommit"
                                                Text="Commit / Віртуальна:"
                                                Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="TxtRamCommit"
                                                Text="—"
                                                Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2"
                                    Margin="0,8,0,0">
                                <TextBlock x:Name="LblDimmSlots"
                                        Text="Встановлені модулі DIMM:"
                                        Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtDimmList"
                                        Text="—"
                                        Style="{StaticResource MetricValue}"
                                        TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Накопичувачі & Плата/BIOS/Мережа -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource SpecCard}"
                                Margin="0,0,6,10">
                            <StackPanel>
                                <TextBlock x:Name="LblStorageSection"
                                        Text="💾 НАКОПИЧУВАЧІ ТА ТОМИ"
                                        FontSize="12.5"
                                        FontWeight="Black"
                                        Foreground="{DynamicResource AccentGreen}"
                                        Margin="0,0,0,8"/>
                                <TextBlock x:Name="LblStorageDisks"
                                        Text="Фізичні диски:"
                                        Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtStorageList"
                                        Text="—"
                                        Style="{StaticResource MetricValue}"
                                        TextWrapping="Wrap"/>
                                <TextBlock x:Name="LblVolumes"
                                        Text="Логічні томи:"
                                        Style="{StaticResource MetricLabel}"
                                        Margin="0,8,6,2"/>
                                <TextBlock x:Name="TxtVolumeList"
                                        Text="—"
                                        Style="{StaticResource MetricValue}"
                                        TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource SpecCard}"
                                Margin="6,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="LblBoardSection"
                                        Text="🎛️ ПЛАТА, BIOS ТА МЕРЕЖА"
                                        FontSize="12.5"
                                        FontWeight="Black"
                                        Foreground="{DynamicResource DangerText}"
                                        Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblBoardModel"
                                            Text="Материнська плата:"
                                            Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtBoardModel"
                                            Text="—"
                                            Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblBoardSensors"
                                            Text="VRM / Плата:"
                                            Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtBoardSensors"
                                            Text="—"
                                            Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblBoardFans"
                                            Text="Кулери:"
                                            Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtBoardFans"
                                            Text="—"
                                            Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblBios"
                                            Text="BIOS:"
                                            Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtBiosVersion"
                                            Text="—"
                                            Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblNetAdapter"
                                            Text="Мережевий адаптер:"
                                            Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtNetAdapter"
                                            Text="—"
                                            Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblNetIp"
                                            Text="IPv4 / MAC:"
                                            Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="TxtNetIp"
                                            Text="—"
                                            Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Нижня панель дій -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                    <Button x:Name="BtnCopyReport"
                            Content="📋 Скопіювати повний звіт"
                            Style="{StaticResource HeaderActionBtn}"
                            Click="BtnCopyReport_Click"/>
                    <Button x:Name="BtnSaveReport"
                            Content="💾 Зберегти звіт (.txt)"
                            Style="{StaticResource HeaderActionBtn}"
                            Click="BtnSaveReport_Click"/>
                    <Button x:Name="BtnRefresh"
                            Content="🔄 Оновити"
                            Style="{StaticResource HeaderActionBtn}"
                            Click="BtnRefresh_Click"/>
                </StackPanel>

                <Button x:Name="BtnCloseWindow"
                        Grid.Column="2"
                        Content="Закрити"
                        Style="{StaticResource HeaderActionBtn}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
