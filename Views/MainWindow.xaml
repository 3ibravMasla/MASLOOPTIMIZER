                        </ScrollViewer>
                    </Grid>

                    <!-- 6. Панель ОЧИЩЕННЯ ДИСКІВ -->
                    <Grid x:Name="CleanerView"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Перемикач режимів: Очищення кешу / Аналізатор диска -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCleanerModeCache"
                                        Content="🧹 Очищення кешу та сміття"
                                        Background="{DynamicResource AccentGreen}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Padding="12,6"
                                        Margin="0,0,8,0"
                                        Cursor="Hand"
                                        Click="BtnCleanerModeCache_Click"/>
                                <Button x:Name="BtnCleanerModeAnalyzer"
                                        Content="📊 Аналізатор диска (WizTree)"
                                        Background="{DynamicResource ActionBtnBg}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        FontWeight="SemiBold"
                                        Padding="12,6"
                                        Cursor="Hand"
                                        Click="BtnCleanerModeAnalyzer_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Режим 1: очищення кешу та сміття -->
                        <Grid x:Name="CleanerCacheModePanel"
                              Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Grid.Row="0">
                                    <TextBlock x:Name="CleanerTitleText"
                                               Text="🧹 ГЛИБОКЕ ОЧИЩЕННЯ ТА ЗВІЛЬНЕННЯ SSD"
                                               FontSize="12"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource AccentGreen}"/>
                                    <TextBlock x:Name="CleanerTotalText"
                                               Text="Підрахунок зайнятого простору..."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Grid.Row="0"
                                            Orientation="Horizontal">
                                    <Button x:Name="BtnCleanAll"
                                            Content="⚡ 1-Click Очистити все"
                                            Background="#E65100"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,6"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"
                                            Click="BtnCleanAll_Click"/>
                                    <Button x:Name="BtnRescanCleaner"
                                            Content="🔄 Пересканувати"
                                            Background="{DynamicResource ActionBtnBg}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            FontWeight="SemiBold"
                                            Padding="10,6"
                                            Cursor="Hand"
                                            Click="BtnRescanCleaner_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,10,0,0">
                                    <TextBlock x:Name="LblSortCleaner"
                                               Text="Сортування:"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CleanerSortComboBox"
                                              SelectionChanged="CleanerSortComboBox_SelectionChanged"
                                              Width="190"
                                              Height="28"
                                              VerticalContentAlignment="Center"
                                              Background="{DynamicResource HeaderBg}"
                                              Foreground="{DynamicResource TextPrimary}"
                                              BorderBrush="{DynamicResource ActionBtnBorder}">
                                        <ComboBoxItem Content="📦 За розміром (спад.)"
                                                      IsSelected="True"
                                                      Tag="SizeDescending"/>
                                        <ComboBoxItem Content="📦 За розміром (зрост.)"
                                                      Tag="SizeAscending"/>
                                        <ComboBoxItem Content="🟢 Безпечні спочатку"
                                                      Tag="SafeFirst"/>
                                        <ComboBoxItem Content="🔤 За назвою (А-Я)"
                                                      Tag="Name"/>
                                        <ComboBoxItem Content="📂 За категорією"
                                                      Tag="Category"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True">
                            <ItemsControl x:Name="CleanerItemsControl"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CleanerItem}">
                                        <Border Background="{DynamicResource CardBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,8"
                                                Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding NameLocalized}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13.5"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding CategoryLocalized}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource BadgeBg}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding SafetyBadgeLocalized}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource InfoText}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource BadgeBg}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding SizeFormatted}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource InfoText}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding DescriptionLocalized}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               Margin="0,5,0,2"
                                                               FontSize="11.5"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="{Binding ActionButtonText}"
                                                        Background="{DynamicResource ActionBtnBg}"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        BorderBrush="{DynamicResource ActionBtnBorder}"
                                                        BorderThickness="1"
                                                        Padding="12,6"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand"
                                                        Click="CleanItem_Click"
                                                        Tag="{Binding}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>

                        <!-- Режим 2: аналізатор диска (WizTree) -->
                        <Grid x:Name="CleanerAnalyzerModePanel"
                              Grid.Row="1"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LblAnalyzerDrive"
                                                   Text="Диск:"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ComboBox x:Name="AnalyzerDriveComboBox"
                                                  Width="290"
                                                  Height="28"
                                                  VerticalContentAlignment="Center"
                                                  Background="{DynamicResource HeaderBg}"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  BorderBrush="{DynamicResource ActionBtnBorder}"
                                                  Margin="0,0,12,0"/>
                                        <TextBlock x:Name="LblAnalyzerFilter"
                                                   Text="Фільтр:"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ComboBox x:Name="AnalyzerFilterComboBox"
                                                  Width="195"
                                                  Height="28"
                                                  VerticalContentAlignment="Center"
                                                  Background="{DynamicResource HeaderBg}"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  BorderBrush="{DynamicResource ActionBtnBorder}"
                                                  SelectionChanged="AnalyzerFilterComboBox_SelectionChanged"
                                                  Margin="0,0,12,0">
                                            <ComboBoxItem Content="📂 Топ важких папок"
                                                          Tag="folders"/>
                                            <ComboBoxItem Content="📄 Топ великих файлів"
                                                          Tag="files"/>
                                            <ComboBoxItem Content="📊 Усі"
                                                          IsSelected="True"
                                                          Tag="all"/>
                                        </ComboBox>
                                        <Button x:Name="BtnAnalyzerScan"
                                                Content="🔍 Сканувати диск"
                                                Background="#0078D4"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                Padding="14,6"
                                                Cursor="Hand"
                                                Click="BtnAnalyzerScan_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="AnalyzerSummaryText"
                                               Text="Оберіть диск та натисніть «Сканувати диск»."
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="11.5"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <ItemsControl x:Name="AnalyzerItemsControl"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:DiskHeavyItem}">
                                            <Border Background="{DynamicResource CardBg}"
                                                    BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Margin="0,0,0,8"
                                                    Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Bold"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       MaxWidth="420"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Border Background="{DynamicResource BadgeBg}"
                                                                    CornerRadius="3"
                                                                    Padding="6,1"
                                                                    Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding CategoryTagLocalized}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource BadgeBg}"
                                                                    CornerRadius="3"
                                                                    Padding="6,1"
                                                                    Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding SizeFormatted}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource InfoText}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding LastModifiedFormatted}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding FullPath}"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="10.5"
                                                                   Margin="0,4,0,4"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Value="{Binding RelativePercent, Mode=OneWay}"
                                                                     Maximum="100"
                                                                     Height="8"
                                                                     Background="{DynamicResource BadgeBg}"
                                                                     Foreground="{DynamicResource AccentGreen}"
                                                                     BorderThickness="0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="{Binding OpenButtonText}"
                                                                Background="{DynamicResource ActionBtnBg}"
                                                                Foreground="{DynamicResource TextPrimary}"
                                                                BorderBrush="{DynamicResource ActionBtnBorder}"
                                                                BorderThickness="1"
                                                                Padding="10,6"
                                                                Margin="4"
                                                                FontWeight="SemiBold"
                                                                Cursor="Hand"
                                                                Click="AnalyzerOpenFolder_Click"
                                                                Tag="{Binding}"/>
                                                        <Button Content="{Binding DeleteButtonText}"
                                                                Background="#C62828"
                                                                Foreground="White"
                                                                Padding="10,6"
                                                                Margin="4"
                                                                FontWeight="SemiBold"
                                                                Cursor="Hand"
                                                                Click="AnalyzerDeleteItem_Click"
                                                                Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Футер -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBg}"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,12,0,0"
                BorderBrush="{DynamicResource StatusBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock Text="⚡ "
                                   Foreground="{DynamicResource AccentGreen}"
                                   FontSize="11.5"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Готово до оптимізації (.NET 8 Core)"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressPercentText"
                                   Text="100%"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentGreen}"
                                   Margin="0,0,12,0"/>
                        <Button x:Name="BtnOpenLogs"
                                Content="📊 Історія дій"
                                Style="{StaticResource HeaderActionBtn}"
                                Padding="8,3"
                                FontSize="10.5"
                                Click="BtnOpenLogs_Click"/>
                        <TextBlock x:Name="LblAuthor"
                                   Text="by 3ibravMasla"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="AppProgressBar"
                             Grid.Row="1"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="100"
                             Background="{DynamicResource ProgressTrack}"
                             Foreground="{DynamicResource ProgressFill}"
                             BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Тост-банер оновлення (плавно з'являється при виявленні нової версії) -->
        <Border x:Name="UpdateToast"
                Grid.RowSpan="3"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,64"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="16,12"
                SnapsToDevicePixels="True"
                Panel.ZIndex="50"
                MaxWidth="560">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.5"
                                  Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="24"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок + кнопка закриття -->
                <Grid Grid.Row="0">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock x:Name="UpdateToastText"
                                   Text="Знайдено нове оновлення MASLOOPTIMIZER!"
                                   FontSize="13"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="UpdateToastSub"
                                   Text="Натисніть «Оновити зараз»..."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnUpdateDismiss"
                            Content="✕"
                            FontSize="13"
                            FontWeight="Bold"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextMuted}"
                            Cursor="Hand"
                            Padding="5,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="Закрити сповіщення"
                            Click="BtnUpdateDismiss_Click"/>
                </Grid>

                <!-- Кнопка оновлення -->
                <Button x:Name="BtnUpdateNow"
                        Grid.Row="1"
                        Content="🚀 Оновити зараз"
                        Background="#8E44AD"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="11.5"
                        Padding="14,7"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Click="BtnUpdateNow_Click"
                        BorderThickness="0"/>

                <!-- Прогрес завантаження -->
                <Grid Grid.Row="2"
                      x:Name="UpdateProgressPanel"
                      Visibility="Collapsed"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Grid.Column="0"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="{DynamicResource ProgressTrack}"
                                 Foreground="{DynamicResource ProgressFill}"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateProgressText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentGreen}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
