<Window x:Class="MASLOOPTIMIZER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MASLOOPTIMIZER"
        Title="MASLOOPTIMIZER .NET 8 Enterprise" Height="900" Width="1380"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        MinWidth="1100" MinHeight="700">

    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Хедер -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MASL" FontSize="20" FontWeight="Black" Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center"/>
                        
                        <Border Width="38" Height="38" CornerRadius="19" BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1.5" Margin="6,0,6,0" VerticalAlignment="Center">
                            <Image x:Name="AppLogoImage" Width="38" Height="38" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/>
                                </Image.Clip>
                            </Image>
                        </Border>

                        <TextBlock Text="PTIMIZER" FontSize="20" FontWeight="Black" Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="v0.3.2 C# Core" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                        </Border>
                    </StackPanel>

                    <!-- Кнопки шапки -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSpecDialog" Style="{StaticResource HeaderActionBtn}" Content="🔍 Специфікації ПК" Click="BtnSpecDialog_Click"/>
                        <Button x:Name="BtnVssPoint" Style="{StaticResource HeaderActionBtn}" Content="🛡️ Точка VSS" Click="BtnVssPoint_Click"/>
                        <Button x:Name="BtnRegBackup" Style="{StaticResource HeaderActionBtn}" Content="💾 Бекап реєстру" Click="BtnRegBackup_Click"/>
                        <Button x:Name="BtnRestoreRollback" Style="{StaticResource HeaderActionBtn}" Content="🔄 Відкат" Click="BtnRestoreRollback_Click"/>
                        <Button x:Name="BtnCheckUpdates" Style="{StaticResource HeaderActionBtn}" Content="🚀 Оновлення" Click="BtnCheckUpdates_Click"/>
                        <Button x:Name="BtnToggleWidget" Style="{StaticResource HeaderActionBtn}" Content="📌 Віджет" Click="BtnToggleWidget_Click"/>
                        <Button x:Name="BtnThemeToggle" Style="{StaticResource HeaderActionBtn}" Content="🌙 Темна тема" Click="BtnThemeToggle_Click"/>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource WindowBg}" CornerRadius="6" Padding="10,6" BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="1">
                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OS: " FontWeight="Bold" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="HwBadgeOS" Text="Завантаження..." FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU: " FontWeight="Bold" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="HwBadgeCPU" Text="Завантаження..." FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GPU: " FontWeight="Bold" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="HwBadgeGPU" Text="Завантаження..." FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM: " FontWeight="Bold" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="HwBadgeRAM" Text="Завантаження..." FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="C: " FontWeight="Bold" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="HwBadgeDisk" Text="Завантаження..." FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Database: " FontWeight="Bold" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="HwBadgeTweaksCount" Text="155 твіків" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 2. Сайдбар + Робоча зона -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Лівий Сайдбар -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource ActionBtnBorder}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                        <TextBox x:Name="SearchInput" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="SearchInput_TextChanged"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button x:Name="NavBtnUI" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="UI">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#8A2BE2" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="QoL" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="Твіки системи/Корисне"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnSafe" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="Safe">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#107C41" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="SAFE" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="Безпечні твіки"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnMed" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="Medium">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#D87A00" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="MED" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="Помірні твіки"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnHigh" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="High">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#C42B1C" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="HIGH" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="Небезпечні твіки"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="{DynamicResource SidebarBorder}" Margin="0,6,0,6"/>

                            <Button x:Name="NavBtnDns" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="DNS">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#3949AB" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="DNS" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="DNS Оптимізатор"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnDebloat" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="DEBLOAT">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#E65100" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="UWP" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="Деблоат UWP програм"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnStartup" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="STARTUP">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#00897B" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="RUN" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="Менеджер автозапуску"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnTools" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="TOOLS">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#0078D4" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="SOFT" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="Інструменти та Софт"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnClean" Style="{StaticResource SidebarNavBtn}" Click="NavBtn_Click" Tag="CLEAN">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#D32F2F" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="CLEAN" FontSize="9" FontWeight="Black" Foreground="White"/></Border>
                                    <TextBlock Text="Очищення дисків"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Нижні кнопки автоматизації -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="АВТОМАТИЗАЦІЯ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                        <Button x:Name="BtnBatchApply" Content="⚡ 1-Click Safe Pack" Background="#107C41" Foreground="White" FontWeight="Bold" FontSize="11" Padding="10,6" Margin="0,0,0,4" Cursor="Hand" Click="BtnBatchApply_Click"/>
                        <Button x:Name="BtnSafeMasloPack" Content="⚡ 1-Click Safe Maslo Pack" Background="#D87A00" Foreground="White" FontWeight="Bold" FontSize="11" Padding="10,6" Margin="0,0,0,4" Cursor="Hand" Click="BtnSafeMasloPack_Click"/>
                        <Button x:Name="BtnPresetMenu" Content="📦 Пресети (JSON)" Style="{StaticResource HeaderActionBtn}" Padding="10,6" Margin="0" Click="BtnPresetMenu_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Права контентна панель -->
            <Border Grid.Column="1" Background="{DynamicResource HeaderBg}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="1">
                <Grid>
                    <!-- 1. Панель ТВІКІВ -->
                    <Grid x:Name="TweaksView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8,10,6" Margin="0,0,0,10">
                            <WrapPanel x:Name="CategoryChipsPanel"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TweaksItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TweakModel}">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border CornerRadius="3" Padding="6,1" Margin="6,0,0,0" Background="{Binding StatusColor}">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,4" FontSize="11.5" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Benefits, StringFormat='✓ {0}'}" Foreground="#059669" FontSize="11" Margin="0,1,0,1"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding ActionButtonText}" Background="#0078D4" Foreground="White" Padding="10,5" Margin="4" FontWeight="SemiBold" Cursor="Hand" Click="ApplyTweak_Click" Tag="{Binding}"/>
                                                    <Button Content="Відновити" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" Padding="10,5" Margin="4" FontWeight="SemiBold" Cursor="Hand" Click="RestoreTweak_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 2. Панель DNS -->
                    <Grid x:Name="DnsView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🌐 ОПТИМІЗАТОР МЕРЕЖЕВИХ ЗАТРИМОК DNS" FontSize="12" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                                    <TextBlock Text="Паралельний вимір пінгу та 1-Click активація найшвидших DNS-серверів" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="⚡ Найшвидший DNS" Background="#107C41" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnFastestDns_Click"/>
                                    <Button Content="🔄 Скинути до DHCP" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Padding="10,6" Cursor="Hand" Click="BtnResetDns_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DnsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DnsPreset}">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"><TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/></Border>
                                                        <Border CornerRadius="3" Padding="6,1" Margin="6,0,0,0" Background="{Binding PingColor}"><TextBlock Text="{Binding PingText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/></Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,2" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding Primary, StringFormat='IP: {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding ButtonText}" Background="#0078D4" Foreground="White" Padding="12,6" FontWeight="Bold" Cursor="Hand" Click="ApplyDns_Click" Tag="{Binding}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 3. Панель ДЕБЛОАТУ -->
                    <Grid x:Name="DebloatView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📦 МЕНЕДЖЕР ДЕБЛОАТУ UWP ПРОГРАМ WINDOWS" FontSize="12" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                                    <TextBlock Text="Видалення вбудованого мотлоху, телеметрії та реклами" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔄 Пересканувати" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Padding="10,6" Cursor="Hand" Click="BtnRescanDebloat_Click"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DebloatItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DebloatItem}">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"><TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/></Border>
                                                        <Border CornerRadius="3" Padding="6,1" Margin="6,0,0,0" Background="{Binding StatusColor}"><TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/></Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,2" FontSize="11.5"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🗑️ Видалити" Background="#C42B1C" Foreground="White" Padding="10,5" Margin="4" FontWeight="SemiBold" Cursor="Hand" Click="UninstallDebloat_Click" Tag="{Binding}"/>
                                                    <Button Content="↩️ Відновити" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" Padding="10,5" Margin="4" FontWeight="SemiBold" Cursor="Hand" Click="RestoreDebloat_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 4. Панель АВТОЗАПУСКУ -->
                    <Grid x:Name="StartupView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🚀 МЕНЕДЖЕР АВТОЗАПУСКУ WINDOWS" FontSize="12" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                                    <TextBlock Text="Керування автозавантаженням та фоновими завданнями" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔄 Оновити" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Padding="10,6" Cursor="Hand" Click="BtnRescanStartup_Click"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="StartupItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:StartupEntry}">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"><TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/></Border>
                                                        <Border CornerRadius="3" Padding="6,1" Margin="6,0,0,0" Background="{Binding StatusColor}"><TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/></Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding ButtonText}" Background="{Binding ButtonBg}" Foreground="White" Padding="12,6" FontWeight="Bold" Cursor="Hand" Click="ToggleStartup_Click" Tag="{Binding}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 5. Панель ІНСТРУМЕНТІВ ТА СОФТУ -->
                    <Grid x:Name="ToolsView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🛠️ БІБЛІОТЕКА НЕОБХІДНОГО СОФТУ ТА ДІАГНОСТИКИ" FontSize="12" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                                <TextBlock Text="Тихе встановлення офіційних інструментів через Winget та прямі лінки" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ToolsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ToolItem}">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"><TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/></Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,2" FontSize="11.5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding StatusText}" Background="#0078D4" Foreground="White" Padding="12,6" Margin="4" FontWeight="SemiBold" Cursor="Hand" Click="InstallTool_Click" Tag="{Binding}"/>
                                                    <Button Content="🌐 Сайт" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" Padding="10,6" Margin="4" FontWeight="SemiBold" Cursor="Hand" Click="OpenToolSite_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 6. Панель ОЧИЩЕННЯ ДИСКІВ -->
                    <Grid x:Name="CleanerView" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🧹 ГЛИБОКЕ ОЧИЩЕННЯ ТА ЗВІЛЬНЕННЯ SSD" FontSize="12" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                                    <TextBlock x:Name="CleanerTotalText" Text="Підрахунок зайнятого простору..." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="⚡ 1-Click Очистити все" Background="#E65100" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnCleanAll_Click"/>
                                    <Button Content="🔄 Пересканувати" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Padding="10,6" Cursor="Hand" Click="BtnRescanCleaner_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CleanerItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CleanerItem}">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"><TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/></Border>
                                                        <Border Background="#1E293B" CornerRadius="3" Padding="6,1" Margin="6,0,0,0"><TextBlock Text="{Binding SizeFormatted}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/></Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,2" FontSize="11.5"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="🧹 Очистити" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ActionBtnBorder}" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" Click="CleanItem_Click" Tag="{Binding}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Футер -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBg}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0" BorderBrush="{DynamicResource StatusBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="⚡ " Foreground="{DynamicResource AccentGreen}" FontSize="11.5" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Text="Готово до оптимізації (.NET 8 Core)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressPercentText" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" Margin="0,0,12,0"/>
                        <Button x:Name="BtnOpenLogs" Content="📊 Історія дій" Style="{StaticResource HeaderActionBtn}" Padding="8,3" FontSize="10.5" Click="BtnOpenLogs_Click"/>
                        <TextBlock Text="by 3ibravMasla" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="AppProgressBar" Grid.Row="1" Height="4" Minimum="0" Maximum="100" Value="100" Background="{DynamicResource ProgressTrack}" Foreground="{DynamicResource ProgressFill}" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>