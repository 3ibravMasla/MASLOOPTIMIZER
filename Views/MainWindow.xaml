<Window x:Class="MASLOOPTIMIZER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MASLOOPTIMIZER"
        Title="MASLOOPTIMIZER v0.6.0"
        Height="900"
        Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        MinWidth="1100"
        MinHeight="700">

    <Grid x:Name="RootGrid"
          Margin="16">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}"
                            ScaleY="{Binding UiScale}"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Хедер -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBg}"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12"
                BorderBrush="{DynamicResource HeaderBorder}"
                BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="MASL"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>

                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                BorderBrush="{DynamicResource AccentGreen}"
                                BorderThickness="1.5"
                                Margin="6,0,6,0"
                                VerticalAlignment="Center">
                            <Image x:Name="AppLogoImage"
                                   Width="38"
                                   Height="38"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="19,19"
                                                     RadiusX="19"
                                                     RadiusY="19"/>
                                </Image.Clip>
                            </Image>
                        </Border>

                        <TextBlock Text="PTIMIZER"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BadgeBg}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="10,0,0,0"
                                BorderBrush="{DynamicResource AccentGreen}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="LblCoreVersion"
                                       Text="v0.6.0"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                    </StackPanel>

                    <!-- Кнопки шапки -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnBackupMenu"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="🛡️ Бекап &amp; VSS"
                                Click="BtnBackupMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="BackupMenu"
                                             Background="{DynamicResource CardBg}"
                                             BorderBrush="{DynamicResource CardBorder}">
                                    <MenuItem x:Name="MiVss"
                                              Header="🛡️ Створити точку VSS"
                                              Click="BtnVssPoint_Click"/>
                                    <MenuItem x:Name="MiRegBackup"
                                              Header="💾 Бекап реєстру"
                                              Click="BtnRegBackup_Click"/>
                                    <MenuItem x:Name="MiRollback"
                                              Header="🔄 Відкат"
                                              Click="BtnRestoreRollback_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="BtnToggleWidget"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="📌 Віджет"
                                Click="BtnToggleWidget_Click"/>
                        <Button x:Name="BtnSpecDialog"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="🔍 Специфікації"
                                Click="BtnSpecDialog_Click"/>
                        <Button x:Name="BtnSettings"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="⚙️ Налаштування"
                                Click="BtnSettings_Click"/>
                        <Button x:Name="BtnVssPoint"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="🛡️ Точка VSS"
                                Click="BtnVssPoint_Click"
                                Visibility="Collapsed"/>
                        <Button x:Name="BtnRegBackup"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="💾 Бекап реєстру"
                                Click="BtnRegBackup_Click"
                                Visibility="Collapsed"/>
                        <Button x:Name="BtnRestoreRollback"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="🔄 Відкат"
                                Click="BtnRestoreRollback_Click"
                                Visibility="Collapsed"/>
                        <Button x:Name="BtnCheckUpdates"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="🚀 Оновлення"
                                Click="BtnCheckUpdates_Click"
                                Visibility="Collapsed"/>
                        <Button x:Name="BtnLangToggle"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="🌐 Мова (UA/EN)"
                                Click="BtnLangToggle_Click"
                                Visibility="Collapsed"/>
                        <Button x:Name="BtnThemeToggle"
                                Style="{StaticResource HeaderActionBtn}"
                                Content="🎨 Тема"
                                Click="BtnThemeToggle_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource WindowBg}"
                        CornerRadius="6"
                        Padding="10,6"
                        BorderBrush="{DynamicResource HeaderBorder}"
                        BorderThickness="1">
                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblHwOs"
                                           Text="OS: "
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="HwBadgeOS"
                                           Text="Завантаження..."
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblHwCpu"
                                           Text="CPU: "
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="HwBadgeCPU"
                                           Text="Завантаження..."
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblHwGpu"
                                           Text="GPU: "
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="HwBadgeGPU"
                                           Text="Завантаження..."
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblHwRam"
                                           Text="RAM: "
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="HwBadgeRAM"
                                           Text="Завантаження..."
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblHwDisk"
                                           Text="C: "
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="HwBadgeDisk"
                                           Text="Завантаження..."
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HwBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblHwDb"
                                           Text="Database: "
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="HwBadgeTweaksCount"
                                           Text="0 твіків"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 2. Сайдбар + Робоча зона -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Лівий Сайдбар -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBg}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,12,0"
                    BorderBrush="{DynamicResource SidebarBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource ActionBtnBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,5"
                            Margin="0,0,0,10">
                        <TextBox x:Name="SearchInput"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderThickness="0"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchInput_TextChanged"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button x:Name="NavBtnTweaks"
                                    Style="{StaticResource SidebarNavBtn}"
                                    Click="NavBtn_Click"
                                    Tag="TWEAKS">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#8A2BE2"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="TWK"
                                                   FontSize="9"
                                                   FontWeight="Black"
                                                   Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="LblNavTweaks"
                                               Text="Твіки системи"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="{DynamicResource SidebarBorder}"
                                       Margin="0,6,0,6"/>

                            <Button x:Name="NavBtnDns"
                                    Style="{StaticResource SidebarNavBtn}"
                                    Click="NavBtn_Click"
                                    Tag="DNS">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#3949AB"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="DNS"
                                                   FontSize="9"
                                                   FontWeight="Black"
                                                   Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="LblNavDns"
                                               Text="DNS Оптимізатор"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnDebloat"
                                    Style="{StaticResource SidebarNavBtn}"
                                    Click="NavBtn_Click"
                                    Tag="DEBLOAT">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#E65100"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="UWP"
                                                   FontSize="9"
                                                   FontWeight="Black"
                                                   Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="LblNavDebloat"
                                               Text="Деблоат UWP програм"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnStartup"
                                    Style="{StaticResource SidebarNavBtn}"
                                    Click="NavBtn_Click"
                                    Tag="STARTUP">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#00897B"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="RUN"
                                                   FontSize="9"
                                                   FontWeight="Black"
                                                   Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="LblNavStartup"
                                               Text="Менеджер автозапуску"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnTools"
                                    Style="{StaticResource SidebarNavBtn}"
                                    Click="NavBtn_Click"
                                    Tag="TOOLS">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#0078D4"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="SOFT"
                                                   FontSize="9"
                                                   FontWeight="Black"
                                                   Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="LblNavTools"
                                               Text="Інструменти та Софт"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnClean"
                                    Style="{StaticResource SidebarNavBtn}"
                                    Click="NavBtn_Click"
                                    Tag="CLEAN">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#D32F2F"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="CLEAN"
                                                   FontSize="9"
                                                   FontWeight="Black"
                                                   Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="LblNavClean"
                                               Text="Очищення дисків"/>
                                </StackPanel>
                            </Button>


                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

            <!-- Права контентна панель -->
            <Border Grid.Column="1"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="8"
                    Padding="16"
                    BorderBrush="{DynamicResource HeaderBorder}"
                    BorderThickness="1">
                <Grid>
                    <!-- 1. Панель ТВІКІВ -->
                    <Grid x:Name="TweaksView"
                          Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель фільтрації: Чіпси + Сортування -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Чіпси категорій -->
                                <WrapPanel Grid.Column="0"
                                           x:Name="CategoryChipsPanel"
                                           VerticalAlignment="Center"/>

                                <!-- Випадаючий список сортування -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <TextBlock x:Name="LblSortTweaks"
                                               Text="Сортування:"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ComboBox x:Name="SortComboBox"
                                              SelectionChanged="SortComboBox_SelectionChanged"
                                              Width="170"
                                              Height="28"
                                              VerticalContentAlignment="Center"
                                              Background="{DynamicResource HeaderBg}"
                                              Foreground="{DynamicResource TextPrimary}"
                                              BorderBrush="{DynamicResource ActionBtnBorder}">
                                        <ComboBoxItem Content="За замовчуванням"
                                                      IsSelected="True"
                                                      Tag="Default"/>
                                        <ComboBoxItem Content="🟢 Застосовані спочатку"
                                                      Tag="AppliedFirst"/>
                                        <ComboBoxItem Content="⚪ Стандартні спочатку"
                                                      Tag="UnappliedFirst"/>
                                        <ComboBoxItem Content="⚠️ За рівнем ризику"
                                                      Tag="Risk"/>
                                        <ComboBoxItem Content="🔤 За назвою (А-Я)"
                                                      Tag="Name"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True">
                            <ItemsControl x:Name="TweaksItemsControl"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TweakModel}">
                                        <Border Background="{DynamicResource CardBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,8"
                                                Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LocalizedName}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13.5"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding LocalizedCategory}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="6,0,0,0"
                                                                Background="{Binding StatusColor}">
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding LocalizedDescription}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               Margin="0,5,0,4"
                                                               FontSize="11.5"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding LocalizedBenefits, StringFormat='✓ {0}'}"
                                                               Foreground="{DynamicResource SuccessText}"
                                                               FontSize="11"
                                                               Margin="0,1,0,1"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="{Binding ActionButtonText}"
                                                            Background="#0078D4"
                                                            Foreground="White"
                                                            Padding="10,5"
                                                            Margin="4"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Click="ApplyTweak_Click"
                                                            Tag="{Binding}"/>
                                                    <Button Content="{Binding RestoreButtonText}"
                                                            Background="{DynamicResource ActionBtnBg}"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Padding="10,5"
                                                            Margin="4"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Click="RestoreTweak_Click"
                                                            Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 2. Панель DNS -->
                    <Grid x:Name="DnsView"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="DnsTitleText"
                                               Text="🌐 ОПТИМІЗАТОР МЕРЕЖЕВИХ ЗАТРИМОК DNS"
                                               FontSize="12"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource AccentGreen}"/>
                                    <TextBlock x:Name="DnsDescText"
                                               Text="Паралельний вимір пінгу та 1-Click активація найшвидших DNS-серверів"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button x:Name="BtnFastestDns"
                                            Content="⚡ Найшвидший DNS"
                                            Background="{DynamicResource SuccessBrush}"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,6"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"
                                            Click="BtnFastestDns_Click"/>
                                    <Button x:Name="BtnResetDns"
                                            Content="🔄 Скинути до DHCP"
                                            Background="{DynamicResource ActionBtnBg}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            FontWeight="SemiBold"
                                            Padding="10,6"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"
                                            Click="BtnResetDns_Click"/>
                                    <Button x:Name="BtnFlushDns"
                                            Content="🔄 Очистити DNS-кеш"
                                            Background="{DynamicResource ActionBtnBg}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            FontWeight="SemiBold"
                                            Padding="10,6"
                                            Cursor="Hand"
                                            Click="BtnFlushDns_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Чіпси категорій DNS та сортування -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0"
                                           x:Name="DnsCategoryChipsPanel"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <TextBlock x:Name="LblSortDns"
                                               Text="Сортування:"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ComboBox x:Name="DnsSortComboBox"
                                              SelectionChanged="DnsSortComboBox_SelectionChanged"
                                              Width="185"
                                              Height="28"
                                              VerticalContentAlignment="Center"
                                              Background="{DynamicResource InputBg}"
                                              Foreground="{DynamicResource TextPrimary}"
                                              BorderBrush="{DynamicResource ActionBtnBorder}">
                                        <ComboBoxItem Content="⚡ Найменший пінг спочатку"
                                                      IsSelected="True"
                                                      Tag="FastestFirst"/>
                                        <ComboBoxItem Content="🔤 За алфавітом"
                                                      Tag="NameAscending"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True">
                            <ItemsControl x:Name="DnsItemsControl"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DnsPreset}">
                                        <Border Background="{DynamicResource CardBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,8"
                                                Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding NameLocalized}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13.5"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource BadgeBg}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding CategoryLocalized}"
                                                                       FontSize="10"
