                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,3,0,8"/>
                                <TextBlock x:Name="NetworkStatusText"
                                           Text="Статус: —"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="0,0,0,8"/>
