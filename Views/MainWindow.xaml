                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <!-- 7. Панель GAME MODE & MSI -->
                    <Grid x:Name="GameMsiView"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Верхній блок: Game Mode -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="GameMsiTitleText"
                                                   Text="🎮 ІГРОВИЙ РЕЖИМ"
                                                   FontSize="12"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource AccentGreen}"/>
                                        <TextBlock x:Name="GameMsiDescText"
                                                   Text="Пріоритет GPU/CPU, зупинка фонових служб та звільнення пам'яті"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock x:Name="GameModeStatusText"
                                                   Text="⚪ Неактивний"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <ToggleButton x:Name="TglGameMode"
                                                      Content="🎮 Game Mode"
                                                      Background="{DynamicResource ActionBtnBg}"
                                                      Foreground="{DynamicResource TextPrimary}"
                                                      BorderBrush="{DynamicResource ActionBtnBorder}"
                                                      Padding="12,6"
                                                      Margin="0,0,6,0"
                                                      Checked="TglGameMode_Checked"
                                                      Unchecked="TglGameMode_Unchecked"/>
                                        <Button x:Name="BtnPurgeStandby"
                                                Content="🧹 Очистити Standby RAM"
                                                Background="#8E44AD"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                Padding="12,6"
                                                Margin="0,0,6,0"
                                                Cursor="Hand"
                                                Click="BtnPurgeStandby_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Принцип роботи Game Mode -->
                                <StackPanel Grid.Row="1"
                                            Margin="0,10,0,0">
                                    <TextBlock x:Name="LblGameModeHow"
                                               Text="📖 ЯК ЦЕ ПРАЦЮЄ"
                                               FontSize="10.5"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtGameModeHow"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="0,2,0,0"
                                               Text="Game Mode зупиняє некритичні фонові служби, піднімає пріоритет процесора та перемикає схему живлення на Ultimate Performance."/>
                                </StackPanel>

                                <!-- Standby RAM Purge -->
                                <StackPanel Grid.Row="2"
                                            Margin="0,8,0,0">
                                    <TextBlock x:Name="LblStandbyPurge"
                                               Text="🧹 STAND BY RAM PURGE"
                                               FontSize="10.5"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtStandbyPurge"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="0,2,0,0"
                                               Text="Скидає модифіковані та резервні сторінки пам'яті через нативний виклик NtSetSystemInformation (SystemMemoryListInformation) для усунення мікрофризів."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Блок MSI Mode -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Інформаційний банер MSI Mode -->
                                <Border Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Background="{DynamicResource ChipBg}"
                                        BorderBrush="{DynamicResource ChipBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="💡"
                                                   FontSize="13"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="MsiEducationalText"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Text="MSI (Message Signaled Interrupts) дозволяє пристроям спілкуватися з процесором безпосередньо, минаючи спільну чергу (IRQ). Це знижує Input Lag та підвищує стабільність FPS. Увага: змінюйте налаштування лише для GPU, активного SSD, мережі та USB з мишею."/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0">
                                    <TextBlock x:Name="MsiTitleText"
                                               Text="⚡ MSI MODE ДЛЯ PCI-ПРИСТРОЇВ"
                                               FontSize="12"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource AccentGreen}"/>
                                    <TextBlock x:Name="MsiStatsText"
                                               Text="Сканування PCI-пристроїв..."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="BtnScanMsi"
                                            Content="🔍 Сканувати PCI"
                                            Background="{DynamicResource ActionBtnBg}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Padding="12,6"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"
                                            Click="BtnScanMsi_Click"/>
                                    <Button x:Name="BtnMsiOptimize"
                                            Content="🚀 1-Click Gaming MSI"
                                            Background="{DynamicResource SuccessBrush}"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,6"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"
                                            Click="BtnMsiOptimize_Click"/>
                                    <Button x:Name="BtnMsiRestore"
                                            Content="↩️ Відновити"
                                            Background="{DynamicResource ActionBtnBg}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Padding="12,6"
                                            Cursor="Hand"
                                            Click="BtnMsiRestore_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,10,0,0">
                                    <TextBlock x:Name="LblSortMsi"
                                               Text="Сортування:"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ComboBox x:Name="MsiSortComboBox"
                                              SelectionChanged="MsiSortComboBox_SelectionChanged"
                                              Width="200"
                                              Height="28"
                                              VerticalContentAlignment="Center"
                                              Background="{DynamicResource HeaderBg}"
                                              Foreground="{DynamicResource TextPrimary}"
                                              BorderBrush="{DynamicResource ActionBtnBorder}">
                                        <ComboBoxItem Content="За замовчуванням"
                                                      IsSelected="True"
                                                      Tag="Default"/>
                                        <ComboBoxItem Content="🟢 MSI спочатку"
                                                      Tag="MsiFirst"/>
                                        <ComboBoxItem Content="⚪ Line-based спочатку"
                                                      Tag="LineBasedFirst"/>
                                        <ComboBoxItem Content="⚡ За пріоритетом"
                                                      Tag="Priority"/>
                                        <ComboBoxItem Content="🔤 За назвою (А-Я)"
                                                      Tag="Name"/>
                                        <ComboBoxItem Content="📂 За категорією"
                                                      Tag="Category"/>
                                        <ComboBoxItem Content="🏢 За вендором"
                                                      Tag="Vendor"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MsiItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PciMsiDevice}">
                                        <Border Background="{DynamicResource CardBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,8"
                                                Padding="14"
                                                ToolTip="{Binding ToolTipText}"
                                                ToolTipService.ShowDuration="20000">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBlacklisted}"
                                                                     Value="True">
                                                            <Setter Property="Opacity"
                                                                    Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CategoryIcon}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   Margin="6,0,0,0"/>
                                                        <TextBlock FontSize="10.5"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IrqNumber}"
                                                                                     Value="">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding IrqLabelText, Mode=OneWay}"/>
                                                            <Run Text="{Binding IrqNumber, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <Border Background="{Binding VendorBadge}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Vendor}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <Border Background="{Binding StatusColor}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding LocationInfo}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="11"
                                                               Margin="0,4,0,2"/>
                                                    <TextBlock FontSize="10.5"
                                                               Foreground="{DynamicResource InfoText}"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AttachedDevices}"
                                                                                 Value="">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding AttachedLabelText, Mode=OneWay}"/>
                                                        <Run Text="{Binding AttachedDevices, Mode=OneWay}"
                                                             FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PriorityLabelText}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontSize="10.5"/>
                                                        <TextBlock Text="{Binding Priority}"
                                                                   Foreground="{Binding PriorityColor}"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding MessageLimit, StringFormat=' | IRQ: {0}'}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontSize="10.5"
                                                                   Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="{Binding ActionButtonText}"
                                                        Background="{Binding ActionButtonBg}"
                                                        Foreground="White"
                                                        Padding="12,6"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand"
                                                        Click="MsiToggle_Click"
                                                        Tag="{Binding}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <!-- 8. Панель МЕРЕЖА & TCP -->
                    <Grid x:Name="NetworkView"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="NetworkTitleText"
                                           Text="⚡ МЕРЕЖА &amp; TCP ОПТИМІЗАЦІЯ"
                                           FontSize="12"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource AccentGreen}"/>
