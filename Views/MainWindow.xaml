                                                               Foreground="{DynamicResource TextSecondary}"
                                                               Margin="0,5,0,2"
                                                               FontSize="11.5"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="{Binding ActionButtonText}"
                                                        Background="{DynamicResource ActionBtnBg}"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        BorderBrush="{DynamicResource ActionBtnBorder}"
                                                        BorderThickness="1"
                                                        Padding="12,6"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand"
                                                        Click="CleanItem_Click"
