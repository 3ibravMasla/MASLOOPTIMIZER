                                    <Button x:Name="BtnNagle"
                                            Content="🔌 1-Click Вимкнути Nagle (TCP NoDelay)"
                                            Background="#0078D4"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,7"
                                            Margin="0,0,8,6"
                                            Cursor="Hand"
                                            Click="BtnNagle_Click"/>
                                    <Button x:Name="BtnEee"
                                            Content="🌿 Вимкнути EEE/Green Ethernet"
                                            Background="#0E7490"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,7"
                                            Margin="0,0,8,6"
                                            Cursor="Hand"
                                            Click="BtnEee_Click"/>
                                    <Button x:Name="BtnQos"
                                            Content="📶 Розблокувати 20% QoS"
                                            Background="#6A1B9A"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,7"
                                            Margin="0,0,8,6"
                                            Cursor="Hand"
                                            Click="BtnQos_Click"/>
                                    <Button x:Name="BtnNetworkReset"
                                            Content="🛟 Аварійне відновлення мережі"
                                            Background="{DynamicResource DangerBrush}"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,7"
                                            Margin="0,0,8,6"
                                            Cursor="Hand"
                                            Click="BtnNetworkReset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="NetworkDetailsText"
                                           Text="Натисніть кнопку для застосування оптимізації мережі."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 9. Панель ПРОФІЛІВ ЖИВЛЕННЯ -->
                    <Grid x:Name="PowerView"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header: пристрій / герцовка / план живлення -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="PowerTitleText"
                                               Text="⚡ ПРОФІЛІ ЖИВЛЕННЯ"
                                               FontSize="15"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource AccentGreen}"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Background="{DynamicResource BadgeBg}"
                                                CornerRadius="4"
                                                Padding="9,3"
                                                Margin="0,0,8,0"
                                                BorderBrush="{DynamicResource AccentGreen}"
                                                BorderThickness="1">
                                            <TextBlock x:Name="PowerDeviceTypeText"
                                                       Text="💻 Настільний ПК"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </Border>
                                        <Border Background="{DynamicResource BadgeBg}"
                                                CornerRadius="4"
                                                Padding="9,3"
                                                Margin="0,0,8,0">
                                            <TextBlock x:Name="PowerHzText"
                                                       Text="Частота: 60 Гц"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </Border>
                                        <Border Background="{DynamicResource BadgeBg}"
                                                CornerRadius="4"
                                                Padding="9,3">
                                            <TextBlock x:Name="PowerPlanNameText"
                                                       Text="Збалансована"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        x:Name="BtnPowerRefresh"
                                        Content="🔄 Оновити"
                                        Background="{DynamicResource ActionBtnBg}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource ActionBtnBorder}"
                                        Padding="12,6"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Click="BtnPowerRefresh_Click"/>
                            </Grid>
                        </Border>

                        <!-- 3 інтерактивні картки -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Eco Saver -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,10,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       x:Name="PowerEcoTitle"
                                                       Text="🌿 Еко-режим"
                                                       FontSize="13"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"/>
                                            <Border Grid.Column="1"
                                                    x:Name="PowerEcoBadge"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    Margin="8,0,0,0"
                                                    Visibility="Collapsed"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="✓ АКТИВНО"
                                                           FontSize="9.5"
                                                           FontWeight="Black"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="PowerEcoDesc"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,8,0,0"
                                                   Text="Знижує споживання: CPU до 60%, дисплей 60 Гц, PCIe ASPM та енергоощадний режим GPU."/>
                                        <Button x:Name="BtnPowerEco"
                                                Content="⚡ Активувати"
                                                Background="{DynamicResource ActionBtnBg}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                BorderBrush="{DynamicResource ActionBtnBorder}"
                                                Padding="12,7"
                                                Margin="0,12,0,0"
                                                Cursor="Hand"
                                                Click="PowerActivate_Click"
                                                Tag="Eco"/>
                                    </StackPanel>
                                </Border>

                                <!-- Original Snapshot -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,10,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       x:Name="PowerSnapshotTitle"
                                                       Text="📸 Зліпок системи"
                                                       FontSize="13"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"/>
                                            <Border Grid.Column="1"
                                                    x:Name="PowerSnapshotBadge"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    Margin="8,0,0,0"
                                                    Visibility="Collapsed"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="✓ АКТИВНО"
                                                           FontSize="9.5"
                                                           FontWeight="Black"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="PowerSnapshotDesc"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,8,0,0"
                                                   Text="Відновлює збережену схему живлення, частоту дисплея та налаштування GPU."/>
                                        <Button x:Name="BtnPowerSnapshot"
                                                Content="⚡ Активувати"
                                                Background="{DynamicResource ActionBtnBg}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                BorderBrush="{DynamicResource ActionBtnBorder}"
                                                Padding="12,7"
                                                Margin="0,12,0,0"
                                                Cursor="Hand"
                                                Click="PowerActivate_Click"
                                                Tag="Snapshot"/>
                                        <Button x:Name="BtnPowerUpdateSnapshot"
                                                Content="🔄 Оновити зліпок"
                                                Background="#8E44AD"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Padding="12,7"
                                                Margin="0,8,0,0"
                                                Cursor="Hand"
                                                Click="BtnPowerUpdateSnapshot_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ultra Performance -->
                                <Border Grid.Column="2"
                                        Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       x:Name="PowerUltraTitle"
                                                       Text="🚀 Максимальна продуктивність"
                                                       FontSize="13"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"/>
                                            <Border Grid.Column="1"
                                                    x:Name="PowerUltraBadge"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    Margin="8,0,0,0"
                                                    Visibility="Collapsed"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="✓ АКТИВНО"
                                                           FontSize="9.5"
                                                           FontWeight="Black"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="PowerUltraDesc"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,8,0,0"
                                                   Text="CPU до 100%, максимальна частота дисплея та вимкнені енергоощадні обмеження."/>
                                        <Button x:Name="BtnPowerUltra"
                                                Content="⚡ Активувати"
                                                Background="{DynamicResource ActionBtnBg}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                BorderBrush="{DynamicResource ActionBtnBorder}"
                                                Padding="12,7"
                                                Margin="0,12,0,0"
                                                Cursor="Hand"
                                                Click="PowerActivate_Click"
                                                Tag="Ultra"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Футер -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBg}"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,12,0,0"
                BorderBrush="{DynamicResource StatusBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock Text="⚡ "
                                   Foreground="{DynamicResource AccentGreen}"
                                   FontSize="11.5"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Готово до оптимізації (.NET 8 Core)"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressPercentText"
                                   Text="100%"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentGreen}"
                                   Margin="0,0,12,0"/>
                        <Button x:Name="BtnOpenLogs"
                                Content="📊 Історія дій"
                                Style="{StaticResource HeaderActionBtn}"
                                Padding="8,3"
                                FontSize="10.5"
                                Click="BtnOpenLogs_Click"/>
                        <TextBlock x:Name="LblAuthor"
                                   Text="by 3ibravMasla"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="AppProgressBar"
                             Grid.Row="1"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="100"
                             Background="{DynamicResource ProgressTrack}"
                             Foreground="{DynamicResource ProgressFill}"
                             BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Тост-банер оновлення (плавно з'являється при виявленні нової версії) -->
        <Border x:Name="UpdateToast"
                Grid.RowSpan="3"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,64"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="16,12"
                SnapsToDevicePixels="True"
                Panel.ZIndex="50"
                MaxWidth="560">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.5"
                                  Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="24"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок + кнопка закриття -->
                <Grid Grid.Row="0">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock x:Name="UpdateToastText"
                                   Text="Знайдено нове оновлення MASLOOPTIMIZER!"
                                   FontSize="13"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="UpdateToastSub"
                                   Text="Натисніть «Оновити зараз»..."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnUpdateDismiss"
                            Content="✕"
                            FontSize="13"
                            FontWeight="Bold"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextMuted}"
                            Cursor="Hand"
                            Padding="5,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="Закрити сповіщення"
                            Click="BtnUpdateDismiss_Click"/>
                </Grid>

                <!-- Кнопка оновлення -->
                <Button x:Name="BtnUpdateNow"
                        Grid.Row="1"
                        Content="🚀 Оновити зараз"
                        Background="#8E44AD"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="11.5"
                        Padding="14,7"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Click="BtnUpdateNow_Click"
                        BorderThickness="0"/>

                <!-- Прогрес завантаження -->
                <Grid Grid.Row="2"
                      x:Name="UpdateProgressPanel"
                      Visibility="Collapsed"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Grid.Column="0"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="{DynamicResource ProgressTrack}"
                                 Foreground="{DynamicResource ProgressFill}"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateProgressText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentGreen}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
