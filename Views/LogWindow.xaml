<Window x:Class="MASLOOPTIMIZER.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MASLOOPTIMIZER"
        Title="Історія дій та Системні логи" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📋 ІСТОРІЯ ОПЕРАЦІЙ ТА ЛОГИ" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📂 Відкрити папку логів" Click="OpenLogsFolder_Click" Style="{DynamicResource HeaderActionBtn}" Padding="10,5" Margin="0,0,8,0"/>
                <Button Content="🗑️ Очистити історію" Click="ClearHistory_Click" Style="{DynamicResource HeaderActionBtn}" Padding="10,5"/>
            </StackPanel>
        </DockPanel>

        <!-- Список логів -->
        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="LogsListView" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LogEntry}">
                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource ActionBtnBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Level}" FontWeight="Bold" FontSize="11" Foreground="{Binding LevelColor}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Підвал -->
        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="Усі події автоматично зберігаються у %ProgramData%\MASLOOPTIMIZER\Logs\history.json" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
    </Grid>
</Window>