<Window x:Class="MASLOOPTIMIZER.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASLO_HUD_WIDGET" Height="360" Width="430"
        WindowStartupLocation="Manual" Top="80" Left="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        MinWidth="280" MinHeight="220">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Display"/>
        </Style>

        <Style x:Key="WidgetActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ActionBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActionBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBrd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBrd" Property="Background" Value="{DynamicResource ChipHoverBg}"/>
                                <Setter TargetName="btnBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBrd" Property="Background" Value="{DynamicResource ChipActiveBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeChipBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ChipText}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBrd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBrd" Property="Background" Value="{DynamicResource ChipHoverBg}"/>
                                <Setter TargetName="chipBrd" Property="BorderBrush" Value="{DynamicResource ChipActiveBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Cursor" Value="SizeNWSE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" Width="14" Height="14">
                            <Path Data="M 10,2 L 12,2 L 12,12 L 2,12 L 2,10 L 10,10 Z M 6,6 L 8,6 L 8,12 L 6,12 Z" Fill="{DynamicResource AccentBrush}" Opacity="0.65"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border x:Name="MainWidgetBorder" Width="430" Height="360" Background="#F00B0E17" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.8"
                CornerRadius="14" Padding="14,10" Margin="4" Cursor="SizeAll" MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect x:Name="MainGlow" BlurRadius="20" ShadowDepth="1" Direction="270" Color="#00FF9D" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <!-- ГОЛОВНИЙ ЕКРАН ТЕЛЕМЕТРІЇ -->
                <Grid x:Name="MainHudView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Хедер віджета -->
                    <Grid Grid.Row="0" Margin="0,2,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Margin="0,-4,-2,0">
                            <Button x:Name="BtnSettings" Content="⚙️" FontSize="13" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}" Cursor="Hand" Padding="3,1" ToolTip="Налаштування віджета" Click="BtnSettings_Click"/>
                            <TextBlock x:Name="BtnCloseWidget" Text="✕" FontSize="13.5" FontWeight="Black" Foreground="#64748B" Cursor="Hand" Margin="5,2,2,0" VerticalAlignment="Center" ToolTip="Приховати в трей" MouseDown="BtnCloseWidget_MouseDown"/>
                        </StackPanel>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="TxtBrandLeft" Text="MASL" FontSize="24" FontWeight="Black" 
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Border Grid.Column="1" x:Name="LogoBorder" Width="86" Height="86" CornerRadius="43" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2.6" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="LogoGlow" BlurRadius="18" Color="#00FF9D" Opacity="0.7"/>
                                </Border.Effect>
                                <Grid>
                                    <Image x:Name="WidgetLogo" Width="82" Height="82" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <EllipseGeometry Center="41,41" RadiusX="41" RadiusY="41"/>
                                        </Image.Clip>
                                    </Image>
                                    <TextBlock x:Name="TxtLogoFallback" Text="🧈" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="2" Text="PTIMIZER" FontSize="24" FontWeight="Black" 
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Телеметрія заліза -->
                    <Border Grid.Row="1" Background="{DynamicResource SidebarBg}" CornerRadius="8" Padding="10,7" Margin="0,0,0,7" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="1">
                        <StackPanel>
                            <!-- CPU -->
                            <Grid Margin="0,0,0,2.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔥 CPU: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCpuModel" Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" x:Name="TxtCpuLoad" Text="0%" FontSize="11" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"/>
                            </Grid>

                            <!-- GPU -->
                            <Grid Margin="0,0,0,2.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🎮 GPU: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" x:Name="TxtGpuModel" Text="GPU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" x:Name="TxtGpuLoad" Text="0%" FontSize="11" FontWeight="Black" Foreground="#38BDF8" Margin="4,0,0,0"/>
                            </Grid>

                            <!-- RAM -->
                            <Grid Margin="0,0,0,2.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡ RAM: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" x:Name="TxtRamUsage" Text="Завантаження..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" x:Name="TxtRamPercent" Text="0%" FontSize="11" FontWeight="Black" Foreground="#F59E0B" Margin="4,0,0,0"/>
                            </Grid>

                            <!-- Диск C: & Мережа -->
                            <Grid Margin="0,0,0,2.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="💾 C: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtDiskUsage" Text="0 / 0 ГБ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="🌐 " FontSize="10.5" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtNetSpeed" Text="↓ 0 KB/s  ↑ 0 KB/s" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Grid>

                            <!-- Uptime -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⏱️ Uptime: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" x:Name="TxtUptime" Text="Розрахунок..." FontSize="10.5" FontWeight="SemiBold" Foreground="#A78BFA"/>
                            </Grid>

                            <ProgressBar x:Name="ProgressRam" Height="4" Background="{DynamicResource ProgressTrack}" Foreground="{DynamicResource ProgressFill}" BorderThickness="0" Minimum="0" Maximum="100" Value="50"/>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки швидких дій -->
                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" x:Name="BtnOpenApp" Style="{StaticResource WidgetActionBtn}" Content="🚀 Головна" ToolTip="Відкрити головне вікно MASLOOPTIMIZER" Click="BtnOpenApp_Click"/>
                        <Button Grid.Row="0" Grid.Column="1" x:Name="BtnTaskMgr" Style="{StaticResource WidgetActionBtn}" Content="📊 Диспетчер" ToolTip="Відкрити Диспетчер завдань Windows" Click="BtnTaskMgr_Click"/>
                        <Button Grid.Row="0" Grid.Column="2" x:Name="BtnReboot" Style="{StaticResource WidgetActionBtn}" Content="🔄 Перезапуск" ToolTip="Чисте повне перезавантаження ПК (з підтвердженням)" Click="BtnReboot_Click"/>

                        <Button Grid.Row="1" Grid.Column="0" x:Name="BtnFlushRam" Style="{StaticResource WidgetActionBtn}" Content="🧹 Очистити ОЗП" ToolTip="Очистити робочі набори пам'яті процесів" Click="BtnFlushRam_Click"/>
                        <Button Grid.Row="1" Grid.Column="1" x:Name="BtnEmptyTrash" Style="{StaticResource WidgetActionBtn}" Content="🗑️ Кошик" ToolTip="Очистити кошик Windows на всіх дисках" Click="BtnEmptyTrash_Click"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="BtnShutdown" Style="{StaticResource WidgetActionBtn}" Content="🛑 Вимкнути" ToolTip="Повне вимкнення комп'ютера (з підтвердженням)" Click="BtnShutdown_Click"/>

                        <Thumb Grid.Row="1" Grid.Column="2" x:Name="ResizeThumb" Style="{StaticResource ResizeThumbStyle}" 
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" 
                               DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
                    </Grid>
                </Grid>

                <!-- ВБУДОВАНА ПАНЕЛЬ НАЛАШТУВАНЬ ВІДЖЕТА -->
                <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#F40B0E17">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="⚙️ НАЛАШТУВАННЯ ВІДЖЕТА" FontSize="13" FontWeight="Black" Foreground="{DynamicResource AccentBrush}"/>
                        <Button Content="✕ Назад" FontSize="11" FontWeight="Bold" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" HorizontalAlignment="Right" Padding="8,3" Cursor="Hand" Click="BtnBackFromSettings_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Стиль підсвітки (Neon Themes):" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="ThemeChipsPanel" Margin="0,0,0,10"/>

                            <Separator Background="{DynamicResource CardBorder}" Margin="0,4,0,8"/>

                            <TextBlock Text="Параметри поведінки:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkAutostart" Content="🚀 Автозапуск віджета при старті Windows" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,6" Click="ChkAutostart_Click"/>
                            <CheckBox x:Name="ChkTopMost" Content="📌 Закріпити поверх усіх вікон (TopMost)" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,6" Click="ChkTopMost_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Готово" Background="#0078D4" Foreground="White" FontWeight="Bold" FontSize="11" Padding="0,7" Margin="0,8,0,0" Cursor="Hand" Click="BtnBackFromSettings_Click"/>
                </Grid>

                <!-- Тост-сповіщення про нове оновлення MASLOOPTIMIZER -->
                <Border x:Name="WidgetUpdateToast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Background="#F20B0E17" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                        CornerRadius="10" Padding="10,8" Margin="2,0,2,2" Panel.ZIndex="50">
                    <Border.RenderTransform>
                        <TranslateTransform Y="18"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="WidgetUpdateText" Text="Знайдено нове оновлення!" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,18,0"/>
                            <Button x:Name="WidgetUpdateDismiss" Content="✕" FontSize="10" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" Cursor="Hand" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Закрити сповіщення" Click="WidgetUpdateDismiss_Click"/>
                        </Grid>
                        <Button x:Name="WidgetUpdateBtn" Content="🚀 Оновити" FontSize="10" FontWeight="Bold" Background="#8E44AD" Foreground="White" BorderThickness="0" Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Left" Cursor="Hand" Click="WidgetUpdateBtn_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Viewbox>
</Window>