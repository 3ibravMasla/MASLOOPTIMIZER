<Window x:Class="MASLOOPTIMIZER.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MASLOOPTIMIZER"
        Title="MASLOOPTIMIZER — Швидкий аудит системи" Height="760" Width="940"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        MinWidth="760" MinHeight="560">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Display"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" Text="🩺 MASL HEALTH AUDIT" FontSize="15" FontWeight="Black" Foreground="{DynamicResource AccentGreen}"/>
                    <TextBlock x:Name="ScoreText" Text="Health Score: --%" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRescan" Content="🔍 Запустити аудит" Background="{DynamicResource ActionBtnBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ActionBtnBorder}" BorderThickness="1" FontWeight="SemiBold" Padding="14,7" Margin="0,0,6,0" Cursor="Hand" Click="BtnRescan_Click"/>
                    <Button x:Name="BtnFixAll" Content="⚡ 1-Click Fix All" Background="#107C41" Foreground="White" FontWeight="Bold" Padding="14,7" Cursor="Hand" Click="BtnFixAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChecksItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:HealthCheckItem}">
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="16" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,3" FontSize="11" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поточне: " Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding CurrentValue}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="   Оптимально: " Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding OptimalValue}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource StatusBg}" BorderBrush="{DynamicResource StatusBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" Text="—" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
