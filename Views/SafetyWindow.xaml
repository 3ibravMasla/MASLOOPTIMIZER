<Window x:Class="MASLOOPTIMIZER.SafetyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASLOOPTIMIZER — Протокол безпеки" Height="800" Width="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Display"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProceedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="#334155" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#107C41"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#22C55E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="10" Background="#10131E" ClipToBounds="True" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <!-- Водяний фоновий знак логотипу -->
            <Image x:Name="BgLogoImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.12"/>
            <Rectangle Fill="#0A0D14" Opacity="0.45"/>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Заголовок -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="🛡️ ВІДМОВА ВІД ВІДПОВІДАЛЬНОСТІ ТА ЗАХИСТ СИСТЕМИ" FontSize="14.5" FontWeight="Black" Foreground="#F59E0B"/>
                    <TextBlock Text="Обов'язковий протокол безпеки перед початком оптимізації операційної системи" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 2. Дисклеймер -->
                <Border Grid.Row="1" Background="#0D111A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="270">
                        <StackPanel>
                            <TextBlock Text="⚠️ ОФІЦІЙНЕ ПОПЕРЕДЖЕННЯ ПРО РИЗИКИ ТА УМОВИ ВИКОРИСТАННЯ:" FontWeight="Black" FontSize="11.5" Foreground="#F87171" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#F8FAFC">
                                • <Bold Foreground="#FBBF24">Глибоке втручання в систему:</Bold> Комплекс <Bold Foreground="#FFFFFF">MASLOOPTIMIZER</Bold> виконує глибокі низькорівневі модифікації параметрів Windows, включаючи масове редагування гілок реєстру HKLM/HKCU, зміну політик безпеки, відключення служб та тюнінг планувальника ядра.<LineBreak/><LineBreak/>
                                • <Bold Foreground="#FBBF24">Повна відмова від відповідальності (Disclaimer):</Bold> Усі оптимізації, деблоат-скрипти, очищення та твіки застосовуються виключно <Bold Foreground="#EF4444">НА ВАШ ВЛАСНИЙ СТРАХ І РИЗИК</Bold>. Розробник та команда проєкту не несуть юридичної чи матеріальної відповідальності за можливу нестабільність системи, пошкодження файлів або збої антивірусного ПЗ.<LineBreak/><LineBreak/>
                                • <Bold Foreground="#FBBF24">Обов'язковий протокол безпеки:</Bold> Доступ до програми заблоковано. Для початку роботи необхідно створити контрольну точку відновлення (VSS) та зберегти резервну копію реєстру.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 3. Кроки безпеки -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <Border Background="#141824" BorderBrush="#21283B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="1. Створення системної точки відновлення Windows (VSS)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                <TextBlock x:Name="TxtRestoreStatus" Text="❌ Не створено (Обов'язковий крок)" FontSize="11" Foreground="#EF4444" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnCreateRestore" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="⚡ Створити точку" Click="BtnCreateRestore_Click"/>
                        </Grid>
                    </Border>

                    <Border Background="#141824" BorderBrush="#21283B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="2. Повний бекап реєстру (Експорт усіх гілок твіків)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                <TextBlock x:Name="TxtRegistryStatus" Text="❌ Не створено (Обов'язковий крок)" FontSize="11" Foreground="#EF4444" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnCreateRegBackup" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="💾 Зберегти реєстр" Click="BtnCreateRegBackup_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 4. Статус -->
                <TextBlock x:Name="TxtLog" Grid.Row="3" Text="Виконайте обидва кроки захисту для розблокування програми." FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4,0,14" TextAlignment="Center"/>

                <!-- 5. Кнопки виходу / продовження -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnExit" Grid.Column="0" Content="✕ Відхилити та вийти" Background="#241416" BorderBrush="#7F1D1D" BorderThickness="1" Foreground="#F87171" FontWeight="Bold" FontSize="11.5" Padding="14,8" Cursor="Hand" Click="BtnExit_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnProceed" Grid.Column="2" Style="{StaticResource ProceedButtonStyle}" Content="🚀 Я усвідомлюю ризики — До програми" IsEnabled="False" Click="BtnProceed_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>