<Window x:Class="MASLOOPTIMIZER.SafetyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafetyWindow" Height="800" Width="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Display"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ChipActiveBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ChipActiveText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ActionBtnBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProceedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ActionBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ActionBtnBorder}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SuccessText}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ChipActiveText}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5" CornerRadius="10" Background="{DynamicResource WindowBg}" ClipToBounds="True" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <!-- Watermark logo -->
            <Image x:Name="BgLogoImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.12"/>
            <Rectangle Fill="{DynamicResource WindowBg}" Opacity="0.45"/>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtSafetyHeading" FontSize="14.5" FontWeight="Black" Foreground="{DynamicResource WarningText}"/>
                    <TextBlock x:Name="TxtSafetySubtitle" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 2. Disclaimer -->
                <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="270">
                        <StackPanel>
                            <TextBlock x:Name="TxtDisclaimerTitle" FontWeight="Black" FontSize="11.5" Foreground="{DynamicResource DangerText}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtDisclaimerBody" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 3. Safety steps -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtStepVssTitle" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtRestoreStatus" FontSize="11" Foreground="{DynamicResource DangerText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnCreateRestore" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Click="BtnCreateRestore_Click"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtStepRegTitle" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtRegistryStatus" FontSize="11" Foreground="{DynamicResource DangerText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnCreateRegBackup" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Click="BtnCreateRegBackup_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 4. Status -->
                <TextBlock x:Name="TxtLog" Grid.Row="3" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,14" TextAlignment="Center"/>

                <!-- 5. Exit / proceed buttons -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnExit" Grid.Column="0" Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Foreground="{DynamicResource DangerText}" FontWeight="Bold" FontSize="11.5" Padding="14,8" Cursor="Hand" Click="BtnExit_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnProceed" Grid.Column="2" Style="{StaticResource ProceedButtonStyle}" IsEnabled="False" Click="BtnProceed_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>